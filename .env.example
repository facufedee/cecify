NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
JWT_SECRET=

LOCAL_DB=

SOCKET_SECRET=

# Captcha "no soy un robot" (Cloudflare Turnstile). Vacias = no se pide. Las cuentas de organizador se crean con
# `npm run create:admin -- usuario` (la contraseña no va en ningun archivo).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Notificaciones push: npx web-push generate-vapid-keys (la publica va en NEXT_PUBLIC_, la privada solo en el servidor)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

